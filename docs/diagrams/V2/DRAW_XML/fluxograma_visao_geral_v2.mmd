flowchart TD

    subgraph FE["Frontend (Next.js) - Somente Admin"]
        B1(["Admin acessa /admin e clica Novo Cartao"])
        B2[/"Insere target_url no modal"/]
        B3["POST /api/links (JWT no header)"]
        B5["Frontend exibe alerta de erro"]
        B12["Atualiza tabela na tela do admin"]
        B13(["Cartao fisico pronto para gravacao"])
    end

    subgraph BE["Backend (FastAPI)"]
        B4{"Token JWT valido?"}
        B7["Consulta ultimo ID inserido"]
        B9["Gera novo slug: cardN+1"]
        B11["Retorna 201 Created"]
        B_err["Retorna 401 Unauthorized"]

        A1["GET /r/slug -- rota direta, sem passar por frontend"]
        A2["Sanitiza slug recebido"]
        A3{"Slug existe no banco?"}
        A4["Retorna HTML 404 (pagina de erro simples)"]
        A5["Dispara BackgroundTask de log"]
        A6["Retorna 307 Temporary Redirect (header Location)"]
        A_exc["Exception Handler global (erro 500 -> HTML amigavel)"]
    end

    subgraph DB["Banco de Dados (PostgreSQL)"]
        B8[("SELECT MAX(id) FROM links")]
        B10[("INSERT INTO links (slug, target_url)")]
        A_db[("SELECT target_url FROM links WHERE slug = ? -- indice em slug")]
        A_log[("INSERT INTO access_logs (slug, timestamp)")]
    end

    NFC(["Smartphone le tag NFC -> api.dominio.com/r/slug"]) --> A1 --> A2 --> A_db --> A3
    A3 -->|Nao| A4 --> FIM_ERR(["Usuario ve pagina de erro simples"])
    A3 -->|Sim| A5
    A5 -.->|"fire-and-forget"| A_log
    A5 --> A6 --> FIM_A(["Usuario chega ao site destino"])
    A1 -.->|"excecao nao tratada"| A_exc -.-> FIM_ERR

    B1 --> B2 --> B3 --> B4
    B4 -->|Nao| B_err --> B5
    B4 -->|Sim| B7 --> B8 --> B9 --> B10 --> B11 --> B12 --> B13

    B10 -.->|"slug agora existe na tabela"| A_db

    classDef terminal fill:#d4edda,stroke:#28a745,stroke-width:2px
    classDef decision fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    classDef db fill:#d1ecf1,stroke:#17a2b8,stroke-width:2px
    classDef error fill:#f8d7da,stroke:#dc3545,stroke-width:2px

    class B1,B13,NFC,FIM_A,FIM_ERR terminal
    class B4,A3 decision
    class B8,B10,A_db,A_log db
    class B_err,A4,B5,A_exc error
