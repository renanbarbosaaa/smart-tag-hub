flowchart TD

    subgraph AT["Atores"]
        ACT1(["Usuario (Visitante)"])
        ACT2(["Site de Destino (ex: LinkedIn)"])
    end

    subgraph DV["Dispositivo / Navegador"]
        DEV1["Tag NFC dispara abertura do navegador"]
        DEV2["Navegador acessa api.dominio.com/r/slug -- direto, sem passar por frontend"]
    end

    subgraph BE["Backend (FastAPI)"]
        BE1["Recebe slug e sanitiza input"]
        BE2["Monta query indexada por slug"]
        BE3{"Registro encontrado no banco?"}
        BE4["Retorna HTML 404 -- pagina de erro simples, sem hop extra"]
        BE_log["Dispara BackgroundTask de log"]
        BE5["Retorna 307 Temporary Redirect (header Location)"]
        BE_exc["Exception Handler global -- erro 500 vira HTML amigavel"]
    end

    subgraph DB["Banco de Dados (PostgreSQL)"]
        DB1[("SELECT target_url FROM links WHERE slug = ? -- indice em slug")]
        DB2[("INSERT INTO access_logs (slug, timestamp)")]
    end

    ACT1 --> DEV1 --> DEV2 --> BE1 --> BE2 --> DB1 --> BE3
    BE3 -->|Nao| BE4 --> ACT1
    BE3 -->|Sim| BE_log
    BE_log -.->|"nao bloqueia a resposta"| DB2
    BE_log --> BE5 --> ACT2
    BE1 -.->|"excecao nao tratada (ex: banco fora do ar)"| BE_exc -.-> ACT1

    classDef ator fill:#e2d9f3,stroke:#6f42c1,stroke-width:2px
    classDef decision fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    classDef db fill:#d1ecf1,stroke:#17a2b8,stroke-width:2px
    classDef error fill:#f8d7da,stroke:#dc3545,stroke-width:2px

    class ACT1,ACT2 ator
    class BE3 decision
    class DB1,DB2 db
    class BE4,BE_exc error
